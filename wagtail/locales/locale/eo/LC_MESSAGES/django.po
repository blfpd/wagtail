#: apps.py:8
msgid "Wagtail locales"
msgstr "Wagtail-lingvoj"

#: forms.py:11 views.py:57
msgid "Language"
msgstr "Lingvo"

#: forms.py:31
msgid "Select a new language"
msgstr "Elekti novan lingvon"

#: templates/wagtaillocales/_language_title_cell.html:7
msgid "This locale's language code is not supported"
msgstr "La lingvokodo de ĉi tiu lingvo ne estas subtenata"

#: templates/wagtaillocales/confirm_delete.html:10
msgid "Yes, delete"
msgstr "Jes, forigi"

#: templates/wagtaillocales/confirm_delete.html:11 templates/wagtaillocales/confirm_delete.html:16
msgid "Back"
msgstr "Reen"

#: templates/wagtaillocales/edit.html:8
msgid "This locale's current language code is not supported. Please choose a new language or delete this locale."
msgstr "La nuna lingvokodo de ĉi tiu lingvo ne estas subtenata. Bonvolu elekti novan lingvon aŭ forigi ĉi tiun lingvon."

#: views.py:37
#, python-format
msgid "%(num_pages)d pages and %(num_others)d others"
msgstr "%(num_pages)d paĝoj kaj %(num_others)d aliaj"

#: views.py:42
#, python-format
msgid "%(num_pages)d page"
msgid_plural "%(num_pages)d pages"
msgstr[0] "%(num_pages)d paĝo"
msgstr[1] "%(num_pages)d paĝoj"

#: views.py:48 wagtail_hooks.py:27
msgid "Locales"
msgstr "Lingvoj"

#: views.py:49
msgid "Add a locale"
msgstr "Aldoni lingvon"

#: views.py:61
msgid "Usage"
msgstr "Uzado"

#: views.py:72
msgid "Add locale"
msgstr "Aldoni lingvon"

#: views.py:73
#, python-format
msgid "Locale '%(object)s' created."
msgstr "Lingvo '%(object)s' kreita."

#: views.py:86
#, python-format
msgid "Locale '%(object)s' updated."
msgstr "Lingvo '%(object)s' ĝisdatigita."

#: views.py:87
msgid "The locale could not be saved due to errors."
msgstr "La lingvo ne povis esti konservita pro eraroj."

#: views.py:93
#, python-format
msgid "Locale '%(object)s' deleted."
msgstr "Lingvo '%(object)s' forigita."

#: views.py:94
msgid "Delete locale"
msgstr "Forigi lingvon"

#: views.py:95
msgid "Are you sure you want to delete this locale?"
msgstr "Ĉu vi certe volas forigi ĉi tiun lingvon?"

#: views.py:101
msgid "This locale cannot be deleted because there are no other locales."
msgstr "Ĉi tiu lingvo ne povas esti forigita, ĉar ne ekzistas aliaj lingvoj."

#: views.py:107
msgid "This locale cannot be deleted because there are pages and/or other objects using it."
msgstr "Ĉi tiu lingvo ne povas esti forigita, ĉar paĝoj kaj/aŭ aliaj objektoj uzas ĝin."
