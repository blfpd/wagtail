#: models.py:27 models.py:102
msgid "permanent"
msgstr "daŭra"

#: models.py:30
msgid "Recommended. Permanent redirects ensure search engines forget the old page (the 'Redirect from') and index the new page instead."
msgstr "Rekomendata. Daŭraj alidirektoj certigas, ke serĉiloj forgesu la malnovan paĝon (la 'Alidirekti de') kaj indeksu anstataŭe la novan paĝon."

#: models.py:36
msgid "redirect to a page"
msgstr "alidirekti al paĝo"

#: models.py:42
msgid "target page route"
msgstr "vojo en la cela paĝo"

#: models.py:44
msgid "Optionally specify a route on the target page to redirect to. Leave blank to redirect to the default page route."
msgstr "Laŭvole indiku vojon en la cela paĝo al kiu alidirekti. Lasu malplena por alidirekti al la defaŭlta vojo de la paĝo."

#: models.py:51
msgid "redirect to any URL"
msgstr "alidirekti al ajna URL"

#: models.py:54
