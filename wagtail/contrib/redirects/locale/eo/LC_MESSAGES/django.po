msgid "redirects"
msgstr "alidirektoj"

#: templates/wagtailredirects/choose_import_file.html:3 views.py:88 wagtail_hooks.py:34
msgid "Redirects"
msgstr "Alidirektoj"

#: templates/wagtailredirects/choose_import_file.html:6 templates/wagtailredirects/confirm_import.html:6 templates/wagtailredirects/import_summary.html:5 views.py:139
msgid "Import redirects"
msgstr "Importi alidirektojn"

#: templates/wagtailredirects/choose_import_file.html:12
msgid "<p>Select a file where redirects are separated into rows and contains the columns representing <code>from</code> and <code>to</code> (they can be named anything).</p> <p>After submitting you will be taken to a confirmation view where you can customize your redirects before import.</p>"
msgstr "<p>Elektu dosieron, en kiu la alidirektoj estas apartigitaj en vicojn kaj kiu enhavas la kolumnojn reprezentantajn <code>from</code> kaj <code>to</code> (ili povas havi ajnan nomon).</p> <p>Post sendo vi estos kondukita al konfirma vido, kie vi povos adapti viajn alidirektojn antaŭ la importo.</p>"

#: templates/wagtailredirects/choose_import_file.html:30
msgid "Import"
msgstr "Importi"

#: templates/wagtailredirects/confirm_delete.html:3
#, python-format
msgid "Delete redirect %(title)s"
msgstr "Forigi alidirekton %(title)s"

#: templates/wagtailredirects/confirm_delete.html:5
msgid "Are you sure you want to delete this redirect?"
msgstr "Ĉu vi certas, ke vi volas forigi ĉi tiun alidirekton?"

#: templates/wagtailredirects/confirm_import.html:4 templates/wagtailredirects/confirm_import.html:7
msgid "Confirm import"
msgstr "Konfirmi importon"

#: templates/wagtailredirects/confirm_import.html:23
msgid "Confirm"
msgstr "Konfirmi"

#: templates/wagtailredirects/confirm_import.html:25
msgid "Cancel"
msgstr "Nuligi"

#: templates/wagtailredirects/confirm_import.html:30
msgid "Preview"
msgstr "Antaŭvido"

#: templates/wagtailredirects/import_summary.html:3 templates/wagtailredirects/import_summary.html:6
msgid "Summary"
msgstr "Resumo"

#: templates/wagtailredirects/import_summary.html:11
#, python-format
msgid "Found %(total)s redirects, created %(successes)s and found %(errors)s errors."
msgstr "Trovis %(total)s alidirektojn, kreis %(successes)s kaj trovis %(errors)s erarojn."

#: templates/wagtailredirects/import_summary.html:17 views.py:93 views.py:125
msgid "From"
msgstr "De"

#: templates/wagtailredirects/import_summary.html:18 views.py:105 views.py:127
msgid "To"
msgstr "Al"

#: templates/wagtailredirects/import_summary.html:19
msgid "Error"
msgstr "Eraro"

#: templates/wagtailredirects/import_summary.html:33
msgid "Continue"
msgstr "Daŭrigi"

#: templates/wagtailredirects/index_results.html:7
#, python-format
msgid "Sorry, no redirects match \"<em>%(query_string)s</em>\""
msgstr "Bedaŭrinde neniu alidirekto kongruas kun \"<em>%(query_string)s</em>\""

#: templates/wagtailredirects/index_results.html:13
#, python-format
msgid "No redirects have been created. Why not <a href=\"%(wagtailredirects_add_redirect_url)s\">add one</a>?"
msgstr "Neniu alidirekto estas kreita. Kial ne <a href=\"%(wagtailredirects_add_redirect_url)s\">aldoni unu</a>?"

#: views.py:79
msgid "Add redirect"
msgstr "Aldoni alidirekton"

#: views.py:99 views.py:126
msgid "Site"
msgstr "Retejo"

#: views.py:156
msgid "The redirect could not be saved due to errors."
msgstr "La alidirekto ne povis esti konservita pro eraroj."

#: views.py:160
#, python-format
msgid "Redirect '%(redirect_title)s' updated."
msgstr "Alidirekto '%(redirect_title)s' ĝisdatigita."

#: views.py:192
#, python-format
msgid "Redirect '%(redirect_title)s' deleted."
msgstr "Alidirekto '%(redirect_title)s' forigita."

#: views.py:204
msgid "The redirect could not be created due to errors."
msgstr "La alidirekto ne povis esti kreita pro eraroj."

#: views.py:208
#, python-format
msgid "Redirect '%(redirect_title)s' added."
msgstr "Alidirekto '%(redirect_title)s' aldonita."

#: views.py:243
msgid "Search redirects"
msgstr "Serĉi alidirektojn"

#: views.py:257
#, python-format
msgid "File format of type \"%(extension)s\" is not supported."
msgstr "Dosierformato de tipo \"%(extension)s\" ne estas subtenata."

#: views.py:274
#, python-format
msgid "Imported file has a wrong encoding: %(error_message)s."
msgstr "La importita dosiero havas malĝustan kodoprezenton: %(error_message)s."

#: views.py:281
#, python-format
msgid "%(error)s encountered while trying to read file: %(filename)s."
msgstr "%(error)s okazis dum provo legi la dosieron: %(filename)s."

#: views.py:372
#, python-format
msgid "Imported %(total)d redirect"
msgid_plural "Imported %(total)d redirects"
msgstr[0] "Importis %(total)d alidirekton"
msgstr[1] "Importis %(total)d alidirektojn"
