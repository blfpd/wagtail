#: apps.py:8
msgid "Wagtail simple translation"
msgstr "Wagtail simpla tradukado"

#: forms.py:28
msgid "Select all"
msgstr "Elekti ĉiujn"

#: forms.py:39
msgid "Locales"
msgstr "Lingvoj"

#: forms.py:44
msgid "All child pages will be created."
msgstr "Ĉiuj subpaĝoj estos kreitaj."

#: forms.py:59
#, python-format
msgid "Include subtree (%(descendant_count)s page)"
msgid_plural "Include subtree (%(descendant_count)s pages)"
msgstr[0] "Inkluzivi subarbon (%(descendant_count)s paĝo)"
msgstr[1] "Inkluzivi subarbon (%(descendant_count)s paĝoj)"

#: forms.py:108
msgid "A locale is disabled because a parent page is not translated."
msgid_plural "Some locales are disabled because some parent pages are not translated."
msgstr[0] "Lingvo estas malŝaltita, ĉar patra paĝo ne estas tradukita."
msgstr[1] "Iuj lingvoj estas malŝaltitaj, ĉar iuj patraj paĝoj ne estas tradukitaj."

#: forms.py:114
msgid "Translate the parent page."
msgid_plural "Translate the parent pages."
msgstr[0] "Traduku la patran paĝon."
msgstr[1] "Traduku la patrajn paĝojn."

#: models.py:21
msgid "Can submit translations"
msgstr "Povas sendi tradukojn"

#: templates/simple_translation/admin/submit_translation.html:26
msgid "Submit"
msgstr "Sendi"

#: views.py:26 wagtail_hooks.py:70 wagtail_hooks.py:88 wagtail_hooks.py:118
msgid "Translate"
msgstr "Traduki"

#. Translators: always plural
#: views.py:82
#, python-format
msgid "%(locales_count)s locales"
msgstr "%(locales_count)s lingvoj"

#: views.py:103
msgid "Translate page"
msgstr "Traduki paĝon"

#: views.py:130
#, python-format
msgid "The page '%(page_title)s' was successfully created in %(locales)s"
msgstr "La paĝo '%(page_title)s' estis sukcese kreita en %(locales)s"

#: views.py:136
#, python-format
msgid "Translate %(model_name)s"
msgstr "Traduki %(model_name)s"

#: views.py:170
#, python-format
msgid "Successfully created %(locales)s for %(model_name)s '%(object)s'"
msgstr "Sukcese kreis %(locales)s por %(model_name)s '%(object)s'"

#: wagtail_hooks.py:92
msgid "Translate this page"
msgstr "Traduki ĉi tiun paĝon"
