#: templates/wagtailsearchpromotions/index_results.html:5 templates/wagtailsearchpromotions/results.html:5
#, python-format
msgid "Sorry, no promoted results match \"<em>%(query_string)s</em>\""
msgstr "Bedaŭrinde neniu reklamita rezulto kongruas kun \"<em>%(query_string)s</em>\""

#: templates/wagtailsearchpromotions/index_results.html:7 templates/wagtailsearchpromotions/results.html:8
#, python-format
