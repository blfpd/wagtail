#: apps.py:8
msgid "Wagtail table block"
msgstr "Wagtail-tabelbloko"

#: blocks.py:73
msgid "Row header"
msgstr "Vica kaplinio"

#: blocks.py:74
msgid "Table headers"
msgstr "Tabelaj kaplinioj"

#: blocks.py:75
msgid "Display the first row as a header"
msgstr "Montri la unuan vicon kiel kaplinion"

#: blocks.py:77
msgid "Display the first column as a header"
msgstr "Montri la unuan kolumnon kiel kaplinion"

#: blocks.py:79
msgid "Column header"
msgstr "Kolumna kaplinio"

#: blocks.py:81
msgid "Display the first row AND first column as headers"
msgstr "Montri la unuan vicon KAJ la unuan kolumnon kiel kapliniojn"

#: blocks.py:83
msgid "No headers"
msgstr "Neniuj kaplinioj"

#: blocks.py:85
msgid "Which cells should be displayed as headers?"
msgstr "Kiuj ĉeloj estu montrataj kiel kaplinioj?"

#: blocks.py:87
msgid "Table caption"
msgstr "Apudskribo de tabelo"

#: blocks.py:89
msgid "A heading that identifies the overall topic of the table, and is useful for screen reader users."
msgstr "Titolo, kiu identigas la ĝeneralan temon de la tabelo kaj utilas al uzantoj de ekranlegiloj."

#: blocks.py:91
msgid "Table"
msgstr "Tabelo"

#: blocks.py:92
msgid "Select a header option"
msgstr "Elekti opcion de kaplinio"
